---
import '@/styles/global.css';
import ToastContainer from '@/components/ToastContainer';
import CommandPalette from '@/components/CommandPalette';
import type { NavItem } from '@/components/CommandPalette';
import { getEnabledPlugins } from '@/lib/plugins';
import type { PluginManifest } from '@/lib/plugins';

export interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Home', activeNav } = Astro.props;
const network = (process.env.NETWORK ?? 'mainnet').toLowerCase();
const indexerEnabled = process.env.INDEXER_ENABLED === 'true';

import pkg from '../../package.json';
const version = pkg.version;

let enabledPlugins: PluginManifest[] = [];
try { enabledPlugins = getEnabledPlugins(); } catch { /* DB may not exist yet */ }

// Distribute plugins into their registered sections (default: apps)
const pluginsBySection = {
  wallet: enabledPlugins.filter(p => p.navSection === 'wallet'),
  assets: enabledPlugins.filter(p => p.navSection === 'assets'),
  trade:  enabledPlugins.filter(p => p.navSection === 'trade'),
  apps:   enabledPlugins.filter(p => !p.navSection || p.navSection === 'apps'),
};

// Build nav items for command palette
const sectionLabel = (p: PluginManifest) =>
  p.navSection ? p.navSection.toUpperCase() : 'APPS';
const navItems: NavItem[] = [
  { key: 'dashboard',        label: 'Dashboard',        href: '/',                  section: 'WALLET'    },
  { key: 'balances',         label: 'Balances',         href: '/balances',          section: 'WALLET'    },
  { key: 'staking',          label: 'Staking',          href: '/staking',           section: 'WALLET'    },
  ...(indexerEnabled ? [
    { key: 'token-management', label: 'Token Management', href: '/token-management', section: 'ASSETS'   },
    { key: 'trading',          label: 'Trading',          href: '/trading',          section: 'TRADE'    },
  ] : []),
  { key: 'management',       label: 'Settings',         href: '/management',        section: 'SETTINGS'  },
  ...enabledPlugins.map(p => ({
    key:     p.id,
    label:   p.navLabel,
    href:    `/plugins/${p.id}/`,
    section: sectionLabel(p),
  })),
];

// Helper: active class for nav items
const navActive   = 'bg-mint-600/20 text-mint-400 font-medium';
const navInactive = 'text-gray-400 hover:text-gray-100 hover:bg-gray-800';

// Default plugin icon path (wrench/tool, Heroicons outline)
const PLUGIN_ICON_DEFAULT = 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z';
---

<!doctype html>
<html lang="en" class="h-full bg-gray-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mintlayer GUI-X: {title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  </head>

  <body class="h-full text-gray-100 font-sans" data-network={network}>
    <ToastContainer client:load />

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-40 flex flex-col bg-gray-900 border-r border-gray-800 -translate-x-full md:translate-x-0"
    >
      <!-- Logo row -->
      <div class="flex items-center h-14 px-4 border-b border-gray-800 shrink-0 gap-2">
        <a href="/" class="flex items-center gap-2 min-w-0">
          <img src="/mintlayer-logo.svg" alt="Mintlayer" class="h-5 shrink-0 brightness-0 invert" />
          <span id="logo-text" class="text-mint-400 font-semibold text-sm whitespace-nowrap">Mintlayer GUI-X</span>
        </a>
        <button
          id="collapse-btn"
          aria-label="Toggle sidebar"
          class="ml-auto shrink-0 p-1 rounded text-gray-500 hover:text-gray-100 hover:bg-gray-800 transition-colors"
        >
          <!-- chevron-left, swapped to chevron-right when collapsed -->
          <svg id="collapse-icon-left" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          <svg id="collapse-icon-right" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>

      <!-- Scrollable nav sections -->
      <nav class="flex-1 overflow-y-auto overflow-x-hidden py-3">

        <!-- ── WALLET ── -->
        <div class="nav-section" data-section="wallet">
          <button class="section-header flex items-center justify-between w-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors">
            <span class="section-label">Wallet</span>
            <svg class="section-chevron w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="section-items space-y-0.5 px-2">
            <a href="/" data-tooltip="Dashboard" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'dashboard' ? navActive : navInactive]}>
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
              <span class="nav-label">Dashboard</span>
            </a>
            <a href="/balances" data-tooltip="Balances" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'balances' ? navActive : navInactive]}>
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="nav-label">Balances</span>
            </a>
            <a href="/staking" data-tooltip="Staking" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'staking' ? navActive : navInactive]}>
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="nav-label">Staking</span>
            </a>
            {pluginsBySection.wallet.map(({ id, navLabel, navIcon }) => (
              <a href={`/plugins/${id}/`} data-tooltip={navLabel} class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === id ? navActive : navInactive]}>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
                </svg>
                <span class="nav-label">{navLabel}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- ── ASSETS (indexer or assets-section plugins) ── -->
        {(indexerEnabled || pluginsBySection.assets.length > 0) && (
          <div class="nav-section mt-1" data-section="assets">
            <button class="section-header flex items-center justify-between w-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors">
              <span class="section-label">Assets</span>
              <svg class="section-chevron w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="section-items space-y-0.5 px-2">
              {indexerEnabled && (
                <a href="/token-management" data-tooltip="Token Management" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'token-management' ? navActive : navInactive]}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                  </svg>
                  <span class="nav-label">Token Management</span>
                </a>
              )}
              {pluginsBySection.assets.map(({ id, navLabel, navIcon }) => (
                <a href={`/plugins/${id}/`} data-tooltip={navLabel} class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === id ? navActive : navInactive]}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={navIcon ?? PLUGIN_ICON_DEFAULT} />
                  </svg>
                  <span class="nav-label">{navLabel}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- ── TRADE (only if indexer enabled or trade-section plugins exist) ── -->
        {(indexerEnabled || pluginsBySection.trade.length > 0) && (
          <div class="nav-section mt-1" data-section="trade">
            <button class="section-header flex items-center justify-between w-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors">
              <span class="section-label">Trade</span>
              <svg class="section-chevron w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="section-items space-y-0.5 px-2">
              {indexerEnabled && (
                <a href="/trading" data-tooltip="Trading" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'trading' ? navActive : navInactive]}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
                  </svg>
                  <span class="nav-label">Trading</span>
                </a>
              )}
              {pluginsBySection.trade.map(({ id, navLabel, navIcon }) => (
                <a href={`/plugins/${id}/`} data-tooltip={navLabel} class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === id ? navActive : navInactive]}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={navIcon ?? PLUGIN_ICON_DEFAULT} />
                  </svg>
                  <span class="nav-label">{navLabel}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- ── APPS (only if any apps-section plugins exist) ── -->
        {pluginsBySection.apps.length > 0 && (
          <div class="nav-section mt-1" data-section="apps">
            <button class="section-header flex items-center justify-between w-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors">
              <span class="section-label">Apps</span>
              <svg class="section-chevron w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="section-items space-y-0.5 px-2">
              {pluginsBySection.apps.map(({ id, navLabel, navIcon }) => (
                <a href={`/plugins/${id}/`} data-tooltip={navLabel} class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === id ? navActive : navInactive]}>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={navIcon ?? PLUGIN_ICON_DEFAULT} />
                  </svg>
                  <span class="nav-label">{navLabel}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </nav>

      <!-- Settings + Sign out pinned at bottom -->
      <div class="shrink-0 border-t border-gray-800 p-2 space-y-0.5">
        <a href="/management" data-tooltip="Settings" class:list={['nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors', activeNav === 'management' ? navActive : navInactive]}>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="nav-label">Settings</span>
        </a>
        <button
          id="signout-trigger"
          type="button"
          data-tooltip="Sign out"
          class="nav-item flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors w-full text-left text-gray-400 hover:text-gray-100 hover:bg-gray-800"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
          <span class="nav-label">Sign out</span>
        </button>
      </div>
    </aside>

    <!-- Restore sidebar + section collapse states before first paint -->
    <script is:inline>
      (function () {
        var s = document.getElementById('sidebar');
        if (!s) return;
        if (localStorage.getItem('sidebar_collapsed') === 'true') {
          s.setAttribute('data-collapsed', '');
          var l = document.getElementById('collapse-icon-left');
          var r = document.getElementById('collapse-icon-right');
          if (l) l.classList.add('hidden');
          if (r) r.classList.remove('hidden');
        }
        ['wallet', 'assets', 'trade', 'apps'].forEach(function (sec) {
          if (localStorage.getItem('sidebar_section_' + sec) === 'collapsed') {
            var el = s.querySelector('[data-section="' + sec + '"] .section-items');
            if (el) el.setAttribute('data-collapsed', '');
            var ch = s.querySelector('[data-section="' + sec + '"] .section-chevron');
            if (ch) ch.style.transform = 'rotate(-90deg)';
          }
        });
      })();
    </script>

    <!-- Mobile overlay backdrop -->
    <div id="mobile-overlay" class="hidden fixed inset-0 z-30 bg-black/60 md:hidden"></div>

    <!-- Mobile top bar (only visible below md) -->
    <header class="md:hidden fixed top-0 inset-x-0 z-30 h-12 bg-gray-900 border-b border-gray-800 flex items-center px-4 gap-3">
      <button
        id="mobile-menu-btn"
        aria-label="Open navigation"
        class="p-1 rounded text-gray-400 hover:text-gray-100 hover:bg-gray-800 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
      <span class="text-mint-400 font-semibold text-sm">Mintlayer GUI-X</span>
    </header>

    <!-- ═══════════════════ CONTENT AREA ═══════════════════ -->
    <div id="content-area" class="flex flex-col min-h-screen pt-12 md:pt-0">
      <!-- Title strip: just the ⌘K shortcut hint, page content provides its own h1 -->
      <div class="flex items-center justify-end px-4 sm:px-6 lg:px-8 pt-4 pb-2">
        <button
          id="open-palette-btn"
          aria-label="Open command palette"
          class="flex items-center gap-1.5 text-xs text-gray-600 hover:text-gray-400 border border-gray-800 rounded px-2 py-1 transition-colors"
        >
          <kbd class="font-mono">⌘K</kbd>
        </button>
      </div>

      <!-- Page content -->
      <main class="flex-1 mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-8">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="border-t border-gray-800 py-4 text-center text-xs text-gray-600">
        Mintlayer GUI-X v{version} &mdash;
        <a href="https://www.mintlayer.org" target="_blank" rel="noopener"
           class="text-gray-500 hover:text-gray-400 transition-colors">mintlayer.org</a>
      </footer>
    </div>

    <!-- Sign-out confirmation modal -->
    <div
      id="signout-modal"
      class="hidden fixed inset-0 z-50 flex items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby="signout-title"
    >
      <div class="absolute inset-0 bg-black/60" id="signout-backdrop"></div>
      <div class="relative bg-gray-900 border border-gray-700 rounded-lg shadow-2xl w-full max-w-sm mx-4 p-6">
        <h2 id="signout-title" class="text-base font-semibold text-gray-100 mb-2">Sign out?</h2>
        <p class="text-sm text-gray-400 mb-6">You will be returned to the login screen.</p>
        <div class="flex gap-3 justify-end">
          <button
            id="signout-cancel"
            class="px-4 py-2 rounded-md text-sm text-gray-300 hover:text-gray-100 hover:bg-gray-800 transition-colors"
          >
            Cancel
          </button>
          <form method="post" action="/api/logout" id="signout-form">
            <button
              type="submit"
              class="px-4 py-2 rounded-md text-sm bg-red-600/80 hover:bg-red-600 text-white transition-colors"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Command palette React island -->
    <CommandPalette items={navItems} client:load />

    <style is:global>
      /* Sidebar expanded/collapsed widths */
      #sidebar {
        width: 15rem;
        transition: width 200ms ease-in-out;
      }
      #sidebar[data-collapsed] {
        width: 4rem;
      }

      /* Hide text labels when collapsed */
      #sidebar[data-collapsed] .nav-label,
      #sidebar[data-collapsed] .section-label,
      #sidebar[data-collapsed] .section-chevron,
      #sidebar[data-collapsed] #logo-text {
        opacity: 0;
        width: 0;
        overflow: hidden;
        pointer-events: none;
      }

      /* Center icons when collapsed */
      #sidebar[data-collapsed] .nav-item {
        justify-content: center;
      }

      /* Hide section headers in icon-only mode */
      #sidebar[data-collapsed] .section-header {
        display: none;
      }

      /* Always show section items in icon-only mode regardless of section collapse */
      #sidebar[data-collapsed] .section-items[data-collapsed] {
        display: block !important;
      }

      /* Collapsed section items */
      .section-items[data-collapsed] {
        display: none;
      }

      /* Content area margin follows sidebar */
      #content-area {
        margin-left: 15rem;
        transition: margin-left 200ms ease-in-out;
      }
      #sidebar[data-collapsed] + * + * + #content-area,
      #sidebar[data-collapsed] ~ #content-area {
        margin-left: 4rem;
      }

      /* Mobile: no margin, sidebar slides in via transform */
      @media (max-width: 767px) {
        #content-area {
          margin-left: 0 !important;
        }
      }

      /* Tooltip for icon-only mode */
      #sidebar[data-collapsed] .nav-item {
        position: relative;
      }
      #sidebar[data-collapsed] .nav-item:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        left: 100%;
        top: 50%;
        transform: translateY(-50%);
        margin-left: 0.5rem;
        white-space: nowrap;
        background: #1f2937;
        color: #e5e7eb;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid #374151;
        pointer-events: none;
        z-index: 50;
      }
    </style>

    <script>
      // ── Sidebar collapse toggle ──
      const sidebar = document.getElementById('sidebar');
      const collapseBtn = document.getElementById('collapse-btn');
      const iconLeft = document.getElementById('collapse-icon-left');
      const iconRight = document.getElementById('collapse-icon-right');

      collapseBtn?.addEventListener('click', () => {
        if (!sidebar) return;
        const collapsed = sidebar.hasAttribute('data-collapsed');
        if (collapsed) {
          sidebar.removeAttribute('data-collapsed');
          iconLeft?.classList.remove('hidden');
          iconRight?.classList.add('hidden');
          localStorage.setItem('sidebar_collapsed', 'false');
        } else {
          sidebar.setAttribute('data-collapsed', '');
          iconLeft?.classList.add('hidden');
          iconRight?.classList.remove('hidden');
          localStorage.setItem('sidebar_collapsed', 'true');
        }
      });

      // ── Section collapse toggles ──
      document.querySelectorAll('.section-header').forEach(btn => {
        btn.addEventListener('click', () => {
          const section = btn.closest('[data-section]') as HTMLElement | null;
          if (!section) return;
          const key = section.dataset.section!;
          const items = section.querySelector('.section-items') as HTMLElement | null;
          const chevron = section.querySelector('.section-chevron') as HTMLElement | null;
          if (!items) return;
          const isCollapsed = items.hasAttribute('data-collapsed');
          if (isCollapsed) {
            items.removeAttribute('data-collapsed');
            if (chevron) chevron.style.transform = '';
            localStorage.setItem('sidebar_section_' + key, 'open');
          } else {
            items.setAttribute('data-collapsed', '');
            if (chevron) chevron.style.transform = 'rotate(-90deg)';
            localStorage.setItem('sidebar_section_' + key, 'collapsed');
          }
        });
      });

      // ── Mobile drawer ──
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const overlay = document.getElementById('mobile-overlay');

      function openDrawer() {
        sidebar?.classList.remove('-translate-x-full');
        sidebar?.classList.add('translate-x-0');
        overlay?.classList.remove('hidden');
      }
      function closeDrawer() {
        sidebar?.classList.remove('translate-x-0');
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      }

      mobileBtn?.addEventListener('click', openDrawer);
      overlay?.addEventListener('click', closeDrawer);

      // ── Sign-out confirmation modal ──
      const signoutModal = document.getElementById('signout-modal');
      document.getElementById('signout-trigger')?.addEventListener('click', () => {
        signoutModal?.classList.remove('hidden');
        document.getElementById('signout-cancel')?.focus();
      });
      document.getElementById('signout-cancel')?.addEventListener('click', () => {
        signoutModal?.classList.add('hidden');
      });
      document.getElementById('signout-backdrop')?.addEventListener('click', () => {
        signoutModal?.classList.add('hidden');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !signoutModal?.classList.contains('hidden')) {
          signoutModal?.classList.add('hidden');
        }
      });

      // ── Command palette open button ──
      document.getElementById('open-palette-btn')
        ?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('cp:open')));

      // ── Copy-to-clipboard ──
      document.body.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLElement>('[data-copy-value]');
        if (!btn) return;
        navigator.clipboard.writeText(btn.dataset.copyValue ?? '').then(() => {
          btn.classList.add('text-mint-400');
          setTimeout(() => btn.classList.remove('text-mint-400'), 1500);
        });
      });
    </script>
  </body>
</html>
