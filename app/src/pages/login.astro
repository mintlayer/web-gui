---
import '@/styles/global.css';
import {
  verifyPassword,
  passwordNeedsRehash,
  hashPassword,
  verifyTOTP,
  generateSessionToken,
  makeSessionCookieHeader,
  checkLoginRateLimit,
  recordLoginFailure,
  SESSION_COOKIE_NAME,
  verifySessionToken, getClientAddress, generateTotpSecret } from '@/lib/auth';
import { getStringPref, getPref, setPref, deletePref } from '@/lib/prefs-db';
import TotpQrCode from '@/components/TotpQrCode';
import { getCredentials, isValidRpId, getRpId } from '@/lib/passkey';

// Current session version; incremented on password change to invalidate old tokens.
// Must match middleware.ts, which checks the same value on every request.
const sessionVersion = getPref<number>('auth.session_version') ?? 0;

// If already authenticated, go home
const existingToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value ?? '';
if (verifySessionToken(existingToken, sessionVersion)) {
  return Astro.redirect('/', 302);
}

// Fail-safe: ensure auth is configured
const passwordHash = getStringPref('auth.password_hash');
const totpSecret   = getStringPref('auth.totp_secret');
const unconfigured = !passwordHash || !totpSecret;

// ── First-run credential bootstrap ──────────────────────────────────────────
// The /setup wizard only creates the WALLET — its password field encrypts the
// wallet file for the daemon, not the web login. On a fresh install there is
// no web credential source (init.sh only ships secrets for deployments), so
// the login page bootstraps them in two steps: (1) choose a password,
// (2) scan the staged TOTP secret and confirm a first code. Pending state
// lives in prefs so reloads and restarts keep it. Public only until both
// factors exist (see middleware.ts).
const restartRequested =
  new URL(Astro.request.url).searchParams.has('restart');
if (restartRequested && unconfigured) {
  deletePref('auth.password_pending');
  deletePref('auth.totp_secret_pending');
}
const pendingHash   = getStringPref('auth.password_pending');
const pendingSecret = getStringPref('auth.totp_secret_pending');
const bootstrapping = unconfigured && Boolean(pendingHash) && Boolean(pendingSecret);


// Passkeys: only show if at least one is enrolled AND the RP ID is valid
const passkeys = getCredentials();
const rpId = getRpId(Astro.request.url);
const hasPasskeys = passkeys.length > 0 && isValidRpId(rpId);

const nextParam = new URL(Astro.request.url).searchParams.get('next') ?? '/';

let errorMessage: string | null = null;

if (Astro.request.method === 'POST' && unconfigured) {
  const ip = getClientAddress(Astro.request, Astro.clientAddress as string | undefined);
  if (!checkLoginRateLimit(ip)) {
    errorMessage = 'Too many attempts. Try again in 15 minutes.';
  } else {
    const form = await Astro.request.formData();
    const stagedHash = getStringPref('auth.password_pending');
    if (!stagedHash) {
      // Step 1: stage the chosen password and a fresh TOTP secret.
      const password = (form.get('password') as string | null) ?? '';
      const confirm  = (form.get('password_confirm') as string | null) ?? '';
      if (password.length < 8) {
        errorMessage = 'Password must be at least 8 characters.';
      } else if (password !== confirm) {
        errorMessage = 'Passwords do not match.';
      } else {
        setPref('auth.password_pending', await hashPassword(password));
        setPref('auth.totp_secret_pending', generateTotpSecret());
        return Astro.redirect(`/login?next=${encodeURIComponent(nextParam)}`, 302);
      }
    } else {
      // Step 2: enroll the authenticator by confirming a first code.
      const totpCode = ((form.get('totp_code') as string | null) ?? '').trim();
      if (/^\d{6}$/.test(totpCode) && verifyTOTP(totpCode, getStringPref('auth.totp_secret_pending'))) {
        setPref('auth.password_hash', stagedHash);
        setPref('auth.totp_secret', getStringPref('auth.totp_secret_pending'));
        deletePref('auth.password_pending');
        deletePref('auth.totp_secret_pending');
        const token = generateSessionToken(sessionVersion);
        const safeDest = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/';
        return new Response(null, {
          status: 302,
          headers: { Location: safeDest, 'Set-Cookie': makeSessionCookieHeader(token) },
        });
      }
      recordLoginFailure(ip);
      // Artificial delay to slow brute-force before lockout kicks in
      await new Promise((r) => setTimeout(r, 500));
      errorMessage = 'Invalid authenticator code.';
    }
  }
}

if (Astro.request.method === 'POST' && !unconfigured) {
  // Socket address first; x-forwarded-for only when TRUST_PROXY=true.
  const ip = getClientAddress(Astro.request, Astro.clientAddress as string | undefined);

  if (!checkLoginRateLimit(ip)) {
    errorMessage = 'Too many login attempts. Try again in 15 minutes.';
  } else {
    const form = await Astro.request.formData();
    const password  = (form.get('password')  as string | null) ?? '';
    const totpCode  = (form.get('totp_code') as string | null) ?? '';

    // Always evaluate both factors to avoid timing side-channels.
    // Deliberately raw verifyTOTP, NOT verifyAndBurnTotpCode: login is already
    // IP-throttled by the login limiter, and burning here would consume the
    // code the user needs seconds later for a step-up (or vice versa — a send
    // would lock them out of logging in for ~60s).
    const [passwordOk, totpOk] = await Promise.all([
      verifyPassword(password, passwordHash),
      Promise.resolve(verifyTOTP(totpCode, totpSecret)),
    ]);

    if (passwordOk && totpOk) {
      // Transparently upgrade hashes created with the old 100k iteration
      // count now that we have the plaintext in hand.
      if (passwordNeedsRehash(passwordHash)) {
        setPref('auth.password_hash', await hashPassword(password));
      }
      const token = generateSessionToken(sessionVersion);
      const safeDest = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/';
      return new Response(null, {
        status: 302,
        headers: {
          Location: safeDest,
          'Set-Cookie': makeSessionCookieHeader(token),
        },
      });
    } else {
      recordLoginFailure(ip);
      // Artificial delay to slow brute-force before lockout kicks in
      await new Promise((r) => setTimeout(r, 500));
      errorMessage = 'Invalid credentials.';
    }
  }
}
---

<!doctype html>
<html lang="en" class="h-full bg-gray-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mintlayer GUI-X - Sign In</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>

  <body class="h-full flex items-center justify-center text-gray-100 font-sans">
    <div class="w-full max-w-sm px-4">

      <!-- Logo / branding -->
      <div class="flex flex-col items-center mb-8 gap-3">
        <img src="/mintlayer-logo.svg" alt="Mintlayer" class="h-7 brightness-0 invert" />
        <span class="text-mint-400 text-xl font-semibold tracking-tight">Mintlayer GUI-X</span>
        <p class="text-gray-500 text-sm">Sign in to your wallet</p>
      </div>

      {unconfigured && !bootstrapping && (
        <div class="mb-4 px-4 py-3 rounded-lg border border-amber-800 bg-amber-950/50 text-amber-300 text-sm">
          First-time setup: create the login credentials for this web UI below.
          (Wallet creation lives at <a href="/setup" class="underline hover:text-amber-200">/setup</a>.)
        </div>
      )}

      {errorMessage && (
        <div role="alert" class="mb-4 px-4 py-3 rounded-lg border border-red-800 bg-red-950/50 text-red-300 text-sm">
          {errorMessage}
        </div>
      )}

      {unconfigured && !bootstrapping && (
        <form
          method="post"
          class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-xl space-y-4"
        >
          <p class="text-xs text-gray-500">Choose a password of at least 8 characters; you'll enroll two-factor authentication next.</p>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-400 mb-1.5">New password</label>
            <input id="password" name="password" type="password" required minlength="8"
              autocomplete="new-password"
              class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100 focus:outline-none focus:ring-2 focus:ring-mint-600 focus:border-transparent transition" />
          </div>
          <div>
            <label for="password_confirm" class="block text-sm font-medium text-gray-400 mb-1.5">Confirm password</label>
            <input id="password_confirm" name="password_confirm" type="password" required minlength="8"
              autocomplete="new-password"
              class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100 focus:outline-none focus:ring-2 focus:ring-mint-600 focus:border-transparent transition" />
          </div>
          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-lg bg-mint-600 hover:bg-mint-700 text-white font-medium
                   transition-colors focus:outline-none focus:ring-2 focus:ring-mint-500
                   focus:ring-offset-2 focus:ring-offset-gray-900"
          >
            Continue to 2FA enrollment
          </button>
        </form>
      )}

      {bootstrapping && (
        <form
          method="post"
          class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-xl space-y-4"
        >
          <p class="text-xs text-gray-500">Scan this QR code with your authenticator app, then enter the 6-digit code to finish setup.</p>
          <div class="flex flex-col items-center gap-3">
            <TotpQrCode client:load uri={`otpauth://totp/${encodeURIComponent('Mintlayer GUI-X')}?secret=${pendingSecret}&issuer=${encodeURIComponent('Mintlayer')}`} />
            <div class="bg-gray-800 rounded-lg p-3 space-y-1 w-full">
              <p class="text-xs text-gray-400">Secret key (manual entry):</p>
              <p class="font-mono text-xs text-gray-200 break-all">{pendingSecret}</p>
            </div>
          </div>
          <div>
            <label for="totp_code" class="block text-sm font-medium text-gray-400 mb-1.5">Authenticator code</label>
            <input id="totp_code" name="totp_code" type="text" required inputmode="numeric" maxlength="6"
              autocomplete="one-time-code" pattern="[0-9]{6}" placeholder="000000"
              class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-mint-600 focus:border-transparent tracking-[0.4em] text-center font-mono transition" />
          </div>
          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-lg bg-mint-600 hover:bg-mint-700 text-white font-medium
                   transition-colors focus:outline-none focus:ring-2 focus:ring-mint-500
                   focus:ring-offset-2 focus:ring-offset-gray-900"
          >
            Finish setup and sign in
          </button>
          <a href="/login?restart=1" class="block text-center text-xs text-gray-500 hover:text-gray-400">Start over</a>
        </form>
      )}

      {!unconfigured && (
      <form
        method="post"
        class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-xl space-y-4"
      >
        <div>
          <label for="password" class="block text-sm font-medium text-gray-400 mb-1.5">
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            disabled={unconfigured}
            class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100
                   placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-mint-600
                   focus:border-transparent transition disabled:opacity-40 disabled:cursor-not-allowed"
          />
        </div>

        <div>
          <label for="totp_code" class="block text-sm font-medium text-gray-400 mb-1.5">
            Authenticator Code
          </label>
          <input
            id="totp_code"
            name="totp_code"
            type="text"
            required
            inputmode="numeric"
            maxlength="6"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            placeholder="000000"
            disabled={unconfigured}
            class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-100
                   placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-mint-600
                   focus:border-transparent tracking-[0.4em] text-center font-mono transition
                   disabled:opacity-40 disabled:cursor-not-allowed"
          />
        </div>

        <button
          type="submit"
          disabled={unconfigured}
          class="w-full py-2.5 px-4 rounded-lg bg-mint-600 hover:bg-mint-700 text-white font-medium
                 transition-colors focus:outline-none focus:ring-2 focus:ring-mint-500
                 focus:ring-offset-2 focus:ring-offset-gray-900
                 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-mint-600"
        >
          Sign in
        </button>
      </form>
      )}

      {hasPasskeys && (
        <div class="mt-4">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-1 h-px bg-gray-800"></div>
            <span class="text-xs text-gray-600">or</span>
            <div class="flex-1 h-px bg-gray-800"></div>
          </div>

          <div id="passkey-error" role="alert" tabindex="-1" class="hidden mb-3 px-4 py-3 rounded-lg border border-red-800 bg-red-950/50 text-red-300 text-sm"></div>

          <button
            id="passkey-btn"
            type="button"
            data-next={nextParam}
            class="w-full py-2.5 px-4 rounded-lg bg-gray-800 hover:bg-gray-700 border border-gray-700
                   text-gray-200 font-medium transition-colors focus:outline-none focus:ring-2
                   focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-950
                   flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
            </svg>
            Sign in with a Passkey
          </button>
        </div>
      )}

    </div>
  </body>
</html>

{hasPasskeys && (
  <script>
    import { startAuthentication } from '@simplewebauthn/browser';

    const btn = document.getElementById('passkey-btn') as HTMLButtonElement | null;
    const errorBox = document.getElementById('passkey-error');

    function showError(msg: string) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
      // Move focus so screen readers announce the asynchronously-populated
      // error (the ceremony leaves focus on the disabled button).
      errorBox.focus();
    }

    const passkeyIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg> Sign in with a Passkey`;

    btn?.addEventListener('click', async () => {
      if (!errorBox || !btn) return;
      errorBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Waiting for authenticator…';

      try {
        const optRes = await fetch('/api/passkey/auth-options');
        if (!optRes.ok) {
          const { error } = await optRes.json();
          throw new Error(error ?? 'Failed to load passkey options.');
        }
        const options = await optRes.json();

        const authResponse = await startAuthentication({ optionsJSON: options });

        const verRes = await fetch('/api/passkey/auth-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(authResponse),
        });
        const result = await verRes.json();

        if (!verRes.ok || !result.ok) {
          throw new Error(result.error ?? 'Passkey authentication failed.');
        }

        const nextParam = btn.dataset.next ?? '/';
        const safeDest = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/';
        window.location.href = safeDest;
      } catch (err: unknown) {
        const e = err as { name?: string; message?: string };
        // AbortError: caller cancelled. NotAllowedError: the user dismissed
        // the OS prompt or it timed out — a routine action, not an error;
        // silently reset so the user can retry.
        if (e?.name !== 'AbortError' && e?.name !== 'NotAllowedError') {
          showError(e?.message ?? 'Passkey authentication failed.');
        }
        btn.disabled = false;
        btn.innerHTML = passkeyIcon;
      }
    });
  </script>
)}
