# Environment / credentials - init.sh writes .env, env_set() rewrites via
# temp files (.env.tmp.<pid>, credentials mid-rewrite) and pre-rewrite
# backups (.env.bak.*). Enumerated (not .env*) so unrelated files like
# direnv's .envrc stay trackable. .env.example is the only tracked env file
# - placeholders only, never real credentials. Note: .gitignore comments
# must start the line; no inline '#'s.
.env
.env.*
!.env*.example

