# Predefined DEV credentials — used only by `make dev` / `make dev-local`.
#
# This stack binds the web UI to 127.0.0.1 and publishes no daemon ports to
# the host, so fixed development credentials are acceptable here. They are
# NOT valid for a real deployment: the installer (./init.sh) generates
# random secrets into .env and never reads this file.
#
# `make dev` generates .env.dev from this file automatically (with a fresh
# random SESSION_SECRET) — you normally never edit this file.

NETWORK=mainnet

# Mintlayer daemon RPC credentials (daemons are only reachable on the
# compose-internal network).
NODE_RPC_USERNAME=dev
NODE_RPC_PASSWORD=dev

# wallet-rpc-daemon RPC credentials (same network constraint).
WALLET_RPC_USERNAME=dev
WALLET_RPC_PASSWORD=dev

# Optional Bitcoin profile (make bitcoin): bitcoind + BDK sidecar.
BITCOIN_RPC_USERNAME=dev-btc
BITCOIN_RPC_PASSWORD=dev-btc
BITCOIN_WALLET_HTTP_USERNAME=dev-btc-wallet
BITCOIN_WALLET_HTTP_PASSWORD=dev-btc-wallet

# Files created by the dev stack are owned by this host user.
ML_USER_ID=1000
ML_GROUP_ID=1000

# Keep the dev UI on loopback even if the host copy of .env says otherwise.
WEB_GUI_BIND=127.0.0.1
